page{background:#f4efe3;color:#334d49;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:28rpx}
.page{padding:36rpx 30rpx 70rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#a45741}.title{font-size:52rpx;font-weight:650;margin:12rpx 0}.hint{font-size:24rpx;line-height:1.7;color:#697b73}.card{padding:28rpx;background:#fffdf7;border:1rpx solid #dbdfce;border-radius:24rpx;margin-top:24rpx}.heading{font-size:31rpx;font-weight:600;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.actions{display:flex;flex-wrap:wrap;margin:16rpx -6rpx 0}.actions button{margin:6rpx;flex:1;min-width:180rpx}button{font-size:26rpx;background:#e7eadf;color:#334d49;border-radius:14rpx;line-height:2.7;padding:0 18rpx}button::after{border:0}button.primary{background:#334d49;color:#fffdf7}button[disabled]{opacity:.45;color:#697b73}.picker{background:#eef0e6;padding:19rpx;border-radius:12rpx;margin-top:10rpx;font-size:26rpx}.label{font-size:24rpx;color:#697b73;margin-top:22rpx}.status{font-size:24rpx;line-height:1.7;color:#a45741;margin-top:16rpx}.clock{text-align:center;font-size:24rpx;font-variant-numeric:tabular-nums;color:#697b73}.link{color:#a45741}.small{font-size:22rpx;color:#697b73}.pill{background:#e7eadf;padding:8rpx 14rpx;border-radius:10rpx;font-size:24rpx}.error{color:#b64231;white-space:pre-wrap}
